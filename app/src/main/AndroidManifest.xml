<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Only needed to download voice/recognition models. The app itself runs offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Keeps recognition running with the screen off / app backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- A foreground service is exempt from most Doze restrictions but does
         not stop the CPU suspending with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 13+: the session notification is the only control surface
         once the screen is off, so this is requested at runtime. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <!-- Declares that this app wants to query the installed TTS engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".VoicePrompterApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoicePrompter">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.VoicePrompter">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".prompter.PrompterService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Routes media-button broadcasts from Bluetooth clickers and headsets
             to the MediaSession while the screen is off. -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
